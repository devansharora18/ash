# Token for cloudflared named tunnel (compose `tunnel` service).
# Generate with: `cloudflared tunnel token ash`
TUNNEL_TOKEN=

# Optional TURN relay (compose `turn` service). Used by WebRTC peers behind
# NAT. Must be reachable on a public IP (ports 3478/tcp+udp open), not behind
# the tunnel. Clients enter turn://<host>:3478 with these credentials.
TURN_REALM=localhost
TURN_USER=ash
TURN_PASSWORD=change-me

# Public IP or hostname of the TURN host (needed if the box is behind NAT).
TURN_EXTERNAL_IP=
# Optional TLS for turns:// (mount cert/key paths into the container, then set).
TURN_TLS_CERT=
TURN_TLS_KEY=
